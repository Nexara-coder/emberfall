# RealmForge II - optional server tuning.
# Every directive here is wrapped so it cannot break older or stripped-down
# Apache installs. If your host still complains, deleting this file is safe -
# the game does not need it.

# Keep the player database out of the web root.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^data/store/ - [F,L]
</IfModule>

# Apache 2.4 syntax
<IfModule mod_authz_core.c>
  <FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm)$">
    Require all denied
  </FilesMatch>
</IfModule>

# Apache 2.2 syntax
<IfModule !mod_authz_core.c>
  <IfModule mod_authz_host.c>
    <FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm)$">
      Order allow,deny
      Deny from all
    </FilesMatch>
  </IfModule>
</IfModule>

# Compress the world data; it is the biggest thing players download.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Cache the static game files. The API sends its own no-cache headers.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/json "access plus 1 days"
</IfModule>
