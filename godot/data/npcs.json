ax":1,"w":12}]},{"key":"warden_of_ash","name":"Warden of Ash","kind":"monster","lvl":104,"hp":320,"hit":22,"att":112,"def":104,"aggro":1,"resp":300,"boss":1,"model":{"kind":"golem","c1":"#5a3428","c2":"#c4562a","sc":2.1},"drops":[{"item":380,"min":1,"max":1,"w":100},{"item":1,"min":2500,"max":7000,"w":100},{"item":356,"min":1,"max":1,"w":25},{"item":98,"min":1,"max":1,"w":8}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"elder_maren","name":"Elder Maren","role":"Village Elder","x":160,"z":262,"model":{"c1":"#e8c9a8","c2":"#6a4a8a","sc":1,"hair":"#d8d4cc"},"dialogue":[{"id":0,"text":"Welcome to Oakheart, traveller. You have the look of someone who's walked a long road.","opts":[{"t":"Where am I?","go":1},{"t":"Do you have work for me?","quest":"welcome"},{"t":"Nothing, thanks.","go":null}]},{"id":1,"text":"Oakheart Vale. Farms to the east, forest north, the river cuts us in two. Aldermere lies up the northeast road.","opts":[{"t":"Thank you.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"banker_orwen","name":"Banker Orwen","role":"Banker","x":168,"z":258,"bank":1,"model":{"c1":"#e0b892","c2":"#2f3a5a","sc":1,"hair":"#3a3028"},"dialogue":[{"id":0,"text":"Good day. Would you like to access your account?","opts":[{"t":"Yes please.","act":"bank"},{"t":"No thank you.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"banker_hild","name":"Banker Hild","role":"Banker","x":250,"z":182,"bank":1,"model":{"c1":"#d8a878","c2":"#2f3a5a","sc":0.98,"hair":"#6a4a2a"},"dialogue":[{"id":0,"text":"Aldermere Central Bank. Your valuables are safe with us.","opts":[{"t":"Open my bank.","act":"bank"},{"t":"Later.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"banker_dorn","name":"Banker Dorn","role":"Banker","x":140,"z":318,"bank":1,"model":{"c1":"#c99a6a","c2":"#2f3a5a","sc":0.95,"hair":"#2a2420"},"dialogue":[{"id":0,"text":"Saltbrook branch. Salt gets everywhere, but your coins stay dry.","opts":[{"t":"Open my bank.","act":"bank"},{"t":"Later.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"banker_brack","name":"Banker Brack","role":"Banker","x":200,"z":58,"bank":1,"model":{"c1":"#d0a070","c2":"#3a3a5a","sc":0.8,"hair":"#8a4a2a","beard":"#8a4a2a"},"dialogue":[{"id":0,"text":"Deep vaults, deeper interest rates. What'll it be?","opts":[{"t":"Open my bank.","act":"bank"},{"t":"Nothing.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"shopkeep_bess","name":"Bess Turnwell","role":"Shopkeeper","x":154,"z":272,"shop":"oakheart_general","model":{"c1":"#e8c9a8","c2":"#7a5a3a","sc":0.95,"hair":"#b07a3c"},"dialogue":[{"id":0,"text":"Rope, pots, tinderboxes - everything a hero forgets to pack.","opts":[{"t":"Let me see your stock.","act":"shop"},{"t":"Just browsing.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"fellstock","name":"Harl Fellstock","role":"Woodcutter","x":148,"z":276,"shop":"oakheart_axes","model":{"c1":"#c99a6a","c2":"#4a5f2a","sc":1.05,"hair":"#5a4a2a","beard":"#5a4a2a"},"dialogue":[{"id":0,"text":"Axes, nets, rods. If it takes something out of the ground or the water, I sell it.","opts":[{"t":"Show me your wares.","act":"shop"},{"t":"Any advice on woodcutting?","go":1},{"t":"Goodbye.","go":null}]},{"id":1,"text":"Start on plain trees. Oaks at fifteen, willows at thirty. A better hatchet cuts faster - don't swing bronze at an ironbark.","opts":[{"t":"Thanks.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"innkeep_pell","name":"Pell Ashcroft","role":"Innkeeper","x":172,"z":276,"shop":"oakheart_food","model":{"c1":"#e0b892","c2":"#6a3a2a","sc":1,"hair":"#3a2a20"},"dialogue":[{"id":0,"text":"Amber Hearth Inn. Hot food, cold beer, and a rat problem I'd rather not discuss.","opts":[{"t":"Buy food.","act":"shop"},{"t":"Tell me about the rats.","quest":"cellar"},{"t":"Goodbye.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"smith_dura","name":"Dura Coldiron","role":"Blacksmith","x":166,"z":280,"model":{"c1":"#c08a5a","c2":"#3a3028","sc":1.05,"hair":"#2a2420"},"dialogue":[{"id":0,"text":"Furnace is hot, anvil's free. Ore goes in, something useful comes out - usually.","opts":[{"t":"Teach me smithing.","go":1},{"t":"Got any work?","quest":"apprentice"},{"t":"Goodbye.","go":null}]},{"id":1,"text":"Smelt ore at a furnace into bars. Take bars to an anvil with a hammer and you can beat them into gear. Copper and tin make bronze.","opts":[{"t":"Understood.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"guard_tomas","name":"Guard Tomas","role":"Guard","x":170,"z":263,"model":{"c1":"#d8a878","c2":"#5a5f6a","sc":1.05,"weap":"Iron longsword"},"dialogue":[{"id":0,"text":"Move along - or don't. Quiet day either way.","opts":[{"t":"Any trouble about?","go":1},{"t":"Goodbye.","go":null}]},{"id":1,"text":"Goblins in the western scrub, spiders in the deep wood. Don't wander east past the Blightfort unless you're tired of living.","opts":[{"t":"Noted.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"farmer_oswin","name":"Farmer Oswin","role":"Farmer","x":204,"z":282,"shop":"farm_seeds","model":{"c1":"#d8b088","c2":"#6a5a2a","sc":1,"hair":"#8a7a4a"},"dialogue":[{"id":0,"text":"Seeds, soil, patience. That's the whole trade.","opts":[{"t":"Buy seeds.","act":"shop"},{"t":"Can you teach me farming?","quest":"seeds"},{"t":"Goodbye.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"fisher_nell","name":"Nell Quay","role":"Fisherwoman","x":138,"z":326,"shop":"saltbrook_fish","model":{"c1":"#c99a6a","c2":"#2a5a6a","sc":0.98,"hair":"#5a4a3a"},"dialogue":[{"id":0,"text":"Tide's good today. Nets on the left, rods on the right.","opts":[{"t":"Show me your stock.","act":"shop"},{"t":"Heard anything strange?","quest":"crate"},{"t":"Goodbye.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"captain_rell","name":"Captain Rell","role":"Harbourmaster","x":146,"z":330,"model":{"c1":"#b88a5a","c2":"#3a4a6a","sc":1.05,"hair":"#4a4038","beard":"#4a4038"},"dialogue":[{"id":0,"text":"Harbourmaster Rell. I keep the ledger and the peace, mostly in that order.","opts":[{"t":"Tell me about the wreck.","quest":"crown"},{"t":"Where do the islands lie?","go":1},{"t":"Goodbye.","go":null}]},{"id":1,"text":"South across the shallows. Three of them. Pirates use the big one - the Drowned Captain's crew, they call themselves.","opts":[{"t":"Thanks.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"lorekeeper_venn","name":"Lorekeeper Venn","role":"Scholar","x":246,"z":196,"model":{"c1":"#e0c0a0","c2":"#3a2a5a","sc":1,"hair":"#d8d4cc"},"dialogue":[{"id":0,"text":"Aldermere's archive. Every debt, every deed, every lie written down twice.","opts":[{"t":"I heard pages went missing.","quest":"ledger"},{"t":"Tell me of the Warden.","quest":"ashes"},{"t":"Goodbye.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"armourer_kest","name":"Kest Coldiron","role":"Armourer","x":258,"z":186,"shop":"aldermere_plate","model":{"c1":"#c08a5a","c2":"#4a4a52","sc":1.1,"beard":"#3a3028"},"dialogue":[{"id":0,"text":"Plate for those who intend to come back.","opts":[{"t":"Show me your stock.","act":"shop"},{"t":"Goodbye.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"weapon_sarn","name":"Sarn the Edge","role":"Weaponsmith","x":256,"z":194,"shop":"aldermere_arms","model":{"c1":"#b88a5a","c2":"#5a2a2a","sc":1.05,"hair":"#2a2420"},"dialogue":[{"id":0,"text":"Sharp things. Reasonably priced.","opts":[{"t":"Show me your stock.","act":"shop"},{"t":"Goodbye.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"mage_ilvara","name":"Ilvara Sootveil","role":"Mage","x":240,"z":178,"shop":"aldermere_magic","model":{"c1":"#e8c9a8","c2":"#4a3f8c","sc":0.98,"hair":"#2a2a3a"},"dialogue":[{"id":0,"text":"Runes, robes, and unsolicited advice.","opts":[{"t":"Show me your stock.","act":"shop"},{"t":"How does magic work here?","go":1},{"t":"I want to learn runecrafting.","quest":"circle"},{"t":"Goodbye.","go":null}]},{"id":1,"text":"Carry the runes a spell demands and cast from the Magic tab. Elemental staves supply their own element - a fire staff means never buying fire runes again.","opts":[{"t":"Thank you.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"fletcher_arn","name":"Arn Yewbend","role":"Fletcher","x":262,"z":200,"shop":"aldermere_range","model":{"c1":"#d8b088","c2":"#3a5a2a","sc":1,"hair":"#6a5a3a"},"dialogue":[{"id":0,"text":"Bows, strings, arrows. I can teach the trade if you've a knife and patience.","opts":[{"t":"Show me your stock.","act":"shop"},{"t":"Teach me fletching.","quest":"fletching"},{"t":"Goodbye.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"jeweller_pia","name":"Pia Facet","role":"Jeweller","x":244,"z":204,"shop":"aldermere_gems","model":{"c1":"#e0b892","c2":"#6a3a5a","sc":0.95,"hair":"#c4a04a"},"dialogue":[{"id":0,"text":"Cut stones, set rings, no questions about where the rough came from.","opts":[{"t":"Show me your stock.","act":"shop"},{"t":"Goodbye.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"priest_aldo","name":"Brother Aldo","role":"Priest","x":96,"z":266,"model":{"c1":"#e0c0a0","c2":"#e8e2d0","sc":1,"hair":"#c8c4bc"},"dialogue":[{"id":0,"text":"Peace of the Vale to you. Bury bones here and the earth remembers the kindness.","opts":[{"t":"Tell me about Prayer.","go":1},{"t":"I seek a pilgrim's task.","quest":"pilgrim"},{"t":"Goodbye.","go":null}]},{"id":1,"text":"Bury bones for prayer experience. Prayers drain while active - recharge at any altar.","opts":[{"t":"Thank you, brother.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"slayer_vex","name":"Vex Harrowgate","role":"Slayer Master","x":236,"z":206,"slayer":1,"model":{"c1":"#a87a5a","c2":"#3a3028","sc":1.05,"hair":"#2a2420","weap":"Steel battleaxe"},"dialogue":[{"id":0,"text":"You want something to kill, and I want it killed. Convenient.","opts":[{"t":"Give me an assignment.","act":"slayer_assign"},{"t":"How am I doing?","act":"slayer_check"},{"t":"Goodbye.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"thief_kito","name":"Kito Sly","role":"Thief","x":232,"z":198,"model":{"c1":"#c99a6a","c2":"#2a2a2a","sc":0.95,"hair":"#1a1a1a"},"dialogue":[{"id":0,"text":"Keep your voice down. And your hand on your purse.","opts":[{"t":"Teach me thieving.","quest":"thief"},{"t":"Goodbye.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"dwarf_borin","name":"Borin Deepvein","role":"Mining Foreman","x":196,"z":66,"shop":"dunhollow_mining","model":{"c1":"#d0a070","c2":"#6a4a2a","sc":0.78,"beard":"#a85a2a","hair":"#a85a2a"},"dialogue":[{"id":0,"text":"Dunhollow. Mind your head and your manners.","opts":[{"t":"Show me your stock.","act":"shop"},{"t":"Need a hand in the mine?","quest":"descent"},{"t":"What lies deeper?","go":1},{"t":"Goodbye.","go":null}]},{"id":1,"text":"Aetherium, if you believe the old songs. Ice trolls, if you believe me.","opts":[{"t":"Charming.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"dwarf_hega","name":"Hega Frostforge","role":"Master Smith","x":206,"z":58,"model":{"c1":"#d0a070","c2":"#5a3a2a","sc":0.8,"hair":"#c8c4bc","beard":"#c8c4bc"},"dialogue":[{"id":0,"text":"The great forge has been cold for eleven years. Don't ask.","opts":[{"t":"I'm asking.","quest":"forge"},{"t":"Goodbye.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"witch_morra","name":"Morra Blackfen","role":"Herbalist","x":60,"z":172,"shop":"mirefen_herbs","model":{"c1":"#c8b8a8","c2":"#3a4a3a","sc":0.98,"hair":"#2a2a2a"},"dialogue":[{"id":0,"text":"Mind the bog. It keeps what it takes.","opts":[{"t":"Show me your stock.","act":"shop"},{"t":"Teach me herblore.","quest":"alchemist"},{"t":"What haunts these ruins?","quest":"whispers"},{"t":"Goodbye.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"watcher_sil","name":"Sil the Watcher","role":"Scout","x":300,"z":200,"model":{"c1":"#b88a5a","c2":"#3a4a3a","sc":1,"hair":"#4a3a2a","weap":"Oak longbow"},"dialogue":[{"id":0,"text":"Past this ridge the land turns. Nothing out there wants to talk.","opts":[{"t":"What is the tower for?","quest":"watcher"},{"t":"Goodbye.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"hunter_jaro","name":"Jaro Snare","role":"Hunter","x":150,"z":212,"model":{"c1":"#a87a5a","c2":"#4a5f2a","sc":1,"hair":"#3a3028"},"dialogue":[{"id":0,"text":"Traps take patience. Everything worth catching does.","opts":[{"t":"How do I hunt?","go":1},{"t":"Goodbye.","go":null}]},{"id":1,"text":"Set a bird snare at a hunting ground and wait. Check it before something else does.","opts":[{"t":"Right.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"miner_gwen","name":"Gwen Tally","role":"Miner","x":152,"z":204,"model":{"c1":"#d8b088","c2":"#5a4a3a","sc":0.98,"hair":"#6a4a2a"},"dialogue":[{"id":0,"text":"Copper and tin here. Iron further in. Bring a pickaxe you can actually lift.","opts":[{"t":"Any work?","quest":"tally"},{"t":"Goodbye.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"agility_nim","name":"Nim Featherstep","role":"Agility Trainer","x":218,"z":244,"model":{"c1":"#e0b892","c2":"#5a3a6a","sc":0.95,"hair":"#3a2a2a"},"dialogue":[{"id":0,"text":"The course starts at the log and ends at the wall. Try not to land on the rocks.","opts":[{"t":"Tell me about agility.","go":1},{"t":"Goodbye.","go":null}]},{"id":1,"text":"Every obstacle gives experience. Finish a full lap for a bonus.","opts":[{"t":"Understood.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":6,"key":"villager_tam","name":"Tam","role":"Villager","x":162,"z":274,"model":{"c1":"#d8b088","c2":"#6a5a4a","sc":0.98,"hair":"#4a3a2a"},"dialogue":[{"id":0,"text":"Lovely weather. Ignore the screaming from the east, it's mostly wind.","opts":[{"t":"Right...","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":6,"key":"villager_rosa","name":"Rosa","role":"Villager","x":156,"z":264,"model":{"c1":"#e8c9a8","c2":"#7a4a5a","sc":0.95,"hair":"#8a5a2a"},"dialogue":[{"id":0,"text":"My cousin went to the Blightlands to make his fortune. We use his room for storage now.","opts":[{"t":"Sorry to hear it.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":4,"key":"villager_hob","name":"Old Hob","role":"Villager","x":167,"z":273,"model":{"c1":"#d0a880","c2":"#4a4238","sc":0.95,"hair":"#d8d4cc","beard":"#d8d4cc"},"dialogue":[{"id":0,"text":"Eh? Speak up. I've been to every corner of this realm, you know.","opts":[{"t":"Every corner?","quest":"longroad"},{"t":"Never mind.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":10,"key":"traveller_esk","name":"Esk the Traveller","role":"Wanderer","x":224,"z":228,"model":{"c1":"#b88a5a","c2":"#5a4a6a","sc":1,"hair":"#2a2420"},"dialogue":[{"id":0,"text":"Roads are safer than they look. The shortcuts aren't.","opts":[{"t":"Safe travels.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"guard_mera","name":"Guard Mera","role":"City Guard","x":254,"z":176,"model":{"c1":"#c99a6a","c2":"#5a5f6a","sc":1,"weap":"Steel longsword"},"dialogue":[{"id":0,"text":"Aldermere keeps the peace. Loudly, if it has to.","opts":[{"t":"Understood.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"guard_owan","name":"Guard Owan","role":"City Guard","x":264,"z":190,"model":{"c1":"#b88a5a","c2":"#5a5f6a","sc":1.05,"weap":"Steel longsword"},"dialogue":[{"id":0,"text":"The castle's open to visitors. The vault isn't.","opts":[{"t":"Fair enough.","go":null}]}]},{"kind":"npc","lvl":0,"hp":10,"wander":0,"key":"cook_mabel","name":"Cook Mabel","role":"Cook","x":252,"z":200,"model":{"c1":"#e0b892","c2":"#e8e2d0","sc":0.98,"hair":"#8a6a4a"},"dialogue":[{"id":0,"text":"Range is over there. Burn it and I'll say nothing. I'll think plenty.","opts":[{"t":"Any cooking tips?","go":1},{"t":"Goodbye.","go":null}]},{"id":1,"text":"Higher cooking level, less burning. A range burns less than an open fire.","opts":[{"t":"Thanks.","go":null}]}]}],"shops":[{"id":"oakheart_general","name":"Oak