; Emberfall - Godot 4 project.
;
; Open this folder in Godot 4.3 or newer. Everything here was rendered and
; verified on 4.3.stable. The first open takes a minute while
; Godot imports the GLB models and PNG textures under assets/ and writes a
; .godot/ cache plus a .import file beside each asset. Those are generated by
; the editor and are intentionally not shipped.
;
; Renderer: GL Compatibility, on every platform. This is deliberate. Forward+
; needs WebGPU, which is not broadly available in browsers, and the whole point
; of this project is that it runs in an ordinary browser served from PHP shared
; hosting.
;
; There is deliberately no [input] section. Camera keys are read directly with
; Input.is_physical_key_pressed() in scripts/camera_rig.gd, so there is no
; input-map binary blob in this file that could be subtly wrong.

config_version=5

[application]

config/name="Emberfall"
config/description="Point-and-click browser MMORPG. Server-authoritative over the PHP API in ../api."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.07, 0.06, 0.05, 1)

[audio]

driver/enable_input=false

[autoload]

; WorldData loads data/*.json and owns the derived height / ground / collision
; grids. Net speaks to the PHP API. Order matters: Net does not touch WorldData,
; but main.tscn expects both to exist before its _ready runs.
WorldData="*res://scripts/world_data.gd"
Net="*res://scripts/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/emberfall_map/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "purple",
"res://data/": "yellow",
"res://scripts/": "blue"
}

[layer_names]

3d_physics/layer_1="terrain"
3d_physics/layer_2="scenery"
3d_physics/layer_3="actors"
3d_physics/layer_4="buildings"

[physics]

common/physics_ticks_per_second=30
3d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_clear_color=Color(0.53, 0.68, 0.82, 1)
